rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isProjectOwner(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    match /projects/{projectId} {
      allow read: if resource.data.visibility != 'private' || isProjectOwner(projectId) || isAdmin();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isProjectOwner(projectId) || isAdmin();
    }
    match /applications/{applicationId} {
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid;
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isProjectOwner(resource.data.projectId) || isAdmin());
      allow update: if signedIn() && (resource.data.applicantId == request.auth.uid || isProjectOwner(resource.data.projectId) || isAdmin());
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds;
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
      }
    }
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.userId == request.auth.uid;
    }
    match /auditLogs/{logId} { allow read: if isAdmin(); allow write: if false; }
  }
}
