# Frontend Environment Variables Example
# Copy this file to .env.local for local development
# Add these variables to your Vercel deployment

# API Configuration - UPDATE THESE AFTER BACKEND DEPLOYMENT
NEXT_PUBLIC_API_URL=https://your-backend-domain.vercel.app/api
NEXT_PUBLIC_WS_URL=wss://your-backend-domain.vercel.app

# Firebase Configuration (Client Side)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDT960YVCmsPyKDaj47k586y9K6DCkKZyo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inspira-grid-c2e1a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inspira-grid-c2e1a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inspira-grid-c2e1a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=210611264492
NEXT_PUBLIC_FIREBASE_APP_ID=1:210611264492:web:f63a6c7c7c26526ff97ec9

# Firebase Emulator Settings (for development)
